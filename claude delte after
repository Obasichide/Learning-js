<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Tip Calculator</title>
<style>
  :root{
    --paper:#FAF6EC;
    --ink:#2B2620;
    --ink-soft:#6B6456;
    --red:#B5432D;
    --green:#4F6F52;
    --line:#D9D2C0;
    box-sizing:border-box;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --paper:#1E1B16;
      --ink:#EFE9DC;
      --ink-soft:#A69C89;
      --red:#E2694F;
      --green:#8FBB94;
      --line:#3A342A;
    }
  }
  *{box-sizing:border-box;}
  html,body{height:100%;}
  body{
    margin:0;
    background-color: color-mix(in srgb, var(--paper) 100%, black 3%);
    font-family: 'Courier New', ui-monospace, SFMono-Regular, Menlo, monospace;
    color:var(--ink);
    display:flex;
    justify-content:center;
    align-items:flex-start;
    min-height:100%;
    padding:36px 16px;
  }
  .receipt{
    width:100%;
    max-width:380px;
    background:var(--paper);
    padding:28px 26px 32px;
    box-shadow: 0 12px 40px rgba(0,0,0,0.18);
    position:relative;
  }
  .receipt::before, .receipt::after{
    content:"";
    position:absolute;
    left:0; right:0;
    height:10px;
    background:
      linear-gradient(135deg, var(--paper) 50%, transparent 50%) 0 0/12px 12px repeat-x,
      linear-gradient(-135deg, var(--paper) 50%, transparent 50%) 0 0/12px 12px repeat-x;
    background-color: color-mix(in srgb, var(--paper) 100%, black 3%);
  }
  .receipt::before{ top:-9px; transform:scaleY(-1); }
  .receipt::after{ bottom:-9px; }

  h1{
    font-family: Georgia, 'Times New Roman', serif;
    font-size:22px;
    letter-spacing:0.5px;
    text-align:center;
    margin:0 0 2px;
  }
  .sub{
    text-align:center;
    font-size:11px;
    color:var(--ink-soft);
    margin:0 0 18px;
  }
  .dashed{
    border:none;
    border-top:1px dashed var(--line);
    margin:16px 0;
  }
  label{
    display:block;
    font-size:11px;
    color:var(--ink-soft);
    margin-bottom:6px;
  }
  .field{ margin-bottom:16px; }
  .amount-row{
    display:flex;
    align-items:center;
    border-bottom:1px solid var(--line);
    padding-bottom:4px;
  }
  .amount-row span{ font-size:20px; margin-right:4px; }
  input[type=number]{
    flex:1;
    border:none;
    background:transparent;
    font-family:inherit;
    font-size:20px;
    color:var(--ink);
    outline:none;
    min-width:0;
  }
  .stepper{
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-bottom:1px solid var(--line);
    padding-bottom:6px;
  }
  .stepper button{
    width:28px;height:28px;
    border:1px solid var(--ink);
    background:none;
    color:var(--ink);
    font-family:inherit;
    font-size:14px;
    cursor:pointer;
  }
  .stepper .val{ font-size:16px; }
  .tip-options{
    display:flex;
    gap:6px;
  }
  .tip-btn{
    flex:1;
    padding:8px 0;
    border:1px solid var(--ink);
    background:none;
    color:var(--ink);
    font-family:inherit;
    font-size:13px;
    cursor:pointer;
  }
  .tip-btn.active{
    background:var(--ink);
    color:var(--paper);
  }
  .note{
    font-size:11px;
    color:var(--ink-soft);
    margin-top:8px;
    min-height:14px;
  }
  .line{
    display:flex;
    justify-content:space-between;
    font-size:13px;
    margin:8px 0;
  }
  .line.total{
    font-size:17px;
    font-weight:bold;
    color:var(--red);
    margin-top:14px;
  }
  .line.each{
    color:var(--green);
  }
  footer{
    text-align:center;
    font-size:10px;
    color:var(--ink-soft);
    margin-top:20px;
    letter-spacing:1px;
  }
</style>
</head>
<body>
<div class="receipt">
  <h1>Tip Calculator</h1>
  <p class="sub">no. 0042 &nbsp;·&nbsp; table for good math</p>

  <div class="dashed"></div>

  <div class="field">
    <label>Bill amount</label>
    <div class="amount-row">
      <span>$</span>
      <input type="number" id="bill" placeholder="0.00" min="0" step="0.01" inputmode="decimal">
    </div>
  </div>

  <div class="field">
    <label>Tip percent</label>
    <div class="tip-options" id="tipOptions">
      <button class="tip-btn" data-tip="10">10%</button>
      <button class="tip-btn active" data-tip="15">15%</button>
      <button class="tip-btn" data-tip="18">18%</button>
      <button class="tip-btn" data-tip="20">20%</button>
      <button class="tip-btn" data-tip="25">25%</button>
    </div>
    <div class="note" id="tipNote"></div>
  </div>

  <div class="field">
    <label>Split between</label>
    <div class="stepper">
      <button id="minus">−</button>
      <span class="val"><span id="people">1</span> <span id="peopleWord">person</span></span>
      <button id="plus">+</button>
    </div>
  </div>

  <div class="dashed"></div>

  <div class="line"><span>Subtotal</span><span id="outSubtotal">$0.00</span></div>
  <div class="line"><span>Tip</span><span id="outTip">$0.00</span></div>
  <div class="line total"><span>Total</span><span id="outTotal">$0.00</span></div>
  <div class="line each" id="eachLine"><span>Each pays</span><span id="outEach">$0.00</span></div>

  <div class="dashed"></div>
  <footer>THANK YOU — COME AGAIN</footer>
</div>

<script>
(function(){
  const billEl = document.getElementById('bill');
  const tipOptions = document.getElementById('tipOptions');
  const tipNote = document.getElementById('tipNote');
  const peopleEl = document.getElementById('people');
  const peopleWord = document.getElementById('peopleWord');
  const minus = document.getElementById('minus');
  const plus = document.getElementById('plus');
  const eachLine = document.getElementById('eachLine');

  const outSubtotal = document.getElementById('outSubtotal');
  const outTip = document.getElementById('outTip');
  const outTotal = document.getElementById('outTotal');
  const outEach = document.getElementById('outEach');

  let tipPercent = 15;
  let people = 1;

  function fmt(n){
    return '$' + n.toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2});
  }

  // 10 comparisons live in this logic:
  function suggestNote(bill, tip){
    if (bill <= 0) {                              // 1
      return '';
    } else if (bill < 15) {                        // 2
      return tip < 18 ? 'Small tab — consider rounding up to 18%.' : 'Generous for a small tab.'; // 3
    } else if (bill >= 15 && bill < 50) {           // 4
      return tip >= 15 ? 'Solid, standard tip.' : 'A bit light for this range.';
    } else if (bill >= 50 && bill <= 150) {         // 5
      return tip !== 20 ? 'Many servers expect 20% at this size.' : 'Right in line with expectations.'; // 6
    } else {
      return tip > 20 ? 'Very generous for a large bill.' : 'Consider 20%+ — big tabs mean big work.'; // 7
    }
  }

  function render(){
    const rawBill = parseFloat(billEl.value);
    const bill = (!isNaN(rawBill) && rawBill > 0) ? rawBill : 0; // 8

    const tip = bill * (tipPercent / 100);
    const total = bill + tip;
    const each = people > 0 ? total / people : total; // 9

    outSubtotal.textContent = fmt(bill);
    outTip.textContent = fmt(tip);
    outTotal.textContent = fmt(total);
    outEach.textContent = fmt(each);

    eachLine.style.display = people > 1 ? 'flex' : 'none';
    peopleWord.textContent = people === 1 ? 'person' : 'people';

    tipNote.textContent = suggestNote(bill, tipPercent);
  }

  tipOptions.addEventListener('click', (e) => {
    const btn = e.target.closest('.tip-btn');
    if (!btn) return; // 10
    tipPercent = parseFloat(btn.dataset.tip);
    [...tipOptions.children].forEach(b => b.classList.toggle('active', b === btn));
    render();
  });

  minus.addEventListener('click', () => {
    if (people > 1) people--;
    peopleEl.textContent = people;
    render();
  });
  plus.addEventListener('click', () => {
    if (people < 50) people++;
    peopleEl.textContent = people;
    render();
  });

  billEl.addEventListener('input', render);
  render();
})();
</script>
</body>
</html>